		"main": [
			"businessjohnv.moneymod.MoneyMod"
		],
		"client": [
			"businessjohnv.moneymod.client.MoneyModClient"
		],
		"fabric-datagen": [
			"businessjohnv.moneymod.client.MoneyModDataGenerator"
		]
	},
	"mixins": [
		"money-mod.mixins.json",
		{
			"config": "money-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
